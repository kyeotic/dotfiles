#!/usr/bin/env bash

# Link Config and home
mkdir -p ~/.config

# stow_pkg: remove real-file conflicts so the repo version always wins.
# stow reports conflicts two ways (foreign symlink, and real file/dir), hence both
# sed patterns. sed, not grep -oP, because BSD grep has no -P.
# --adopt was removed because it moves local files INTO the repo, overwriting it.
stow_pkg() {
  local src=$1 tgt=$2 pkg=$3
  stow -n -d "$src" -t "$tgt" -S "$pkg" 2>&1 \
    | sed -n -e 's/.*existing target is not owned by stow: //p' \
              -e 's/.*over existing target \(.*\) since neither a link nor a directory.*/\1/p' \
    | while IFS= read -r f; do
        echo "Removing conflict: $tgt/$f"
        rm -rf "$tgt/$f"
      done
  stow -d "$src" -t "$tgt" -S "$pkg"
}

stow_pkg "$HOME/dotfiles" ~/.config .config/
stow_pkg "$HOME/dotfiles" ~/ home

# Linux-only ~/.config files. Same stow dir and target as .config/ so stow can
# unfold a shared dir (e.g. ghostty/) that .config/ already linked whole.
if [[ "$(uname)" == "Linux" ]]; then
  stow_pkg "$HOME/dotfiles" ~/.config config-linux
fi

# Agent skills: one canonical copy in .agents/skills, linked per-agent
"$HOME/dotfiles/scripts/agent-skill" link

# if [[ -a $HOME/.hyper.js ]]; then rm $HOME/.hyper.js; fi
# ln $HOME/dotfiles/configs/.hyper.js $HOME/.hyper.js 