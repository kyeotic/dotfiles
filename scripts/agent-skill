#!/usr/bin/env bash

# Manage agent-agnostic skills in one or more .agents/ roots.
#
#   agent-skill link                              link every enabled skill into its agent's config dir
#   agent-skill add [--root <dir>] <name> [agent...]   create the skill if missing, enable it, link it
#   agent-skill rename [--root <dir>] <old> <new>      rename a skill and relink it for every agent
#   agent-skill roots                             print the roots in precedence order
#
# Skills live once in <root>/skills/<name>/. Each agent opts in via a symlink in
# <root>/<agent>/skills/. Default agents: claude codex.
#
# Roots come from AGENT_SKILL_ROOTS, a colon-separated list of .agents dirs in precedence
# order: later roots win when two hold a skill of the same name. Default is just
# $DOTFILES/.agents. Set it in ~/.localrc to add a private root, e.g.
#   export AGENT_SKILL_ROOTS="$HOME/dotfiles/.agents:$HOME/dev/tkye-nourish/.agents"

set -eu

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
DEFAULT_AGENTS=(claude codex)

ROOTS=()
IFS=: read -r -a ROOTS <<< "${AGENT_SKILL_ROOTS:-$DOTFILES/.agents}"

usage() {
  sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# Where an agent reads its skills from.
skills_dir_for() {
  case $1 in
    claude) echo "$HOME/.claude/skills" ;;
    codex) echo "$HOME/.codex/skills" ;;
    *) echo "$HOME/.$1/skills" ;;
  esac
}

# Every agent dir that exists under any root, deduplicated.
all_agents() {
  local root dir
  for root in "${ROOTS[@]}"; do
    for dir in "$root"/*/; do
      dir=${dir%/}
      [[ -d $dir/skills ]] && basename "$dir"
    done
  done | sort -u
}

# Link <root>/<agent>/skills/* into the agent's real skills dir. Per-skill rather than the
# whole directory, because those dirs also hold skills installed by other tools. ln -sfn
# overwrites, so calling this for each root in order gives later roots precedence.
link_agent() {
  local root=$1 agent=$2
  local src="$root/$agent/skills"
  local tgt
  tgt=$(skills_dir_for "$agent")

  [[ -d $src ]] || return 0
  mkdir -p "$tgt"

  local skill dest
  for skill in "$src"/*; do
    [[ -e $skill ]] || continue
    dest="$tgt/$(basename "$skill")"
    if [[ -e $dest && ! -L $dest ]]; then
      echo "Skipping $agent skill, target is not a symlink: $dest"
      continue
    fi
    ln -sfn "$skill" "$dest"
  done
}

cmd_link() {
  local root agent
  for root in "${ROOTS[@]}"; do
    [[ -d $root ]] || { echo "Skipping missing root: $root"; continue; }
    for agent in "$@"; do
      link_agent "$root" "$agent"
    done
  done
}

# Relink everything, so a change in one root (rename, removal) lets a shadowed skill from a
# lower-precedence root show through again.
relink_all() {
  local agents=()
  while IFS= read -r a; do agents+=("$a"); done < <(all_agents)
  [[ ${#agents[@]} -gt 0 ]] && cmd_link "${agents[@]}"
  return 0
}

# Parse a leading --root <dir> (or --root=<dir>) into $ROOT and shift it off. Default: first root.
ROOT=""
ROOT_GIVEN=""
parse_root() {
  ROOT=${ROOTS[0]}
  REST=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --root) ROOT=$2; ROOT_GIVEN=1; shift 2 ;;
      --root=*) ROOT=${1#--root=}; ROOT_GIVEN=1; shift ;;
      *) REST+=("$1"); shift ;;
    esac
  done
  ROOT=${ROOT%/}
}

cmd_add() {
  parse_root "$@"
  set -- "${REST[@]+"${REST[@]}"}"
  local name=${1:-}
  [[ -n $name ]] || usage 1
  shift

  local agents=("$@")
  [[ ${#agents[@]} -gt 0 ]] || agents=("${DEFAULT_AGENTS[@]}")

  local skill="$ROOT/skills/$name"
  if [[ -d $skill ]]; then
    echo "Skill exists: $skill"
  else
    mkdir -p "$skill"
    cat > "$skill/SKILL.md" <<SKILL
---
name: $name
description: <one line: what this does, and the phrases that should trigger it>
---

# ${name//-/ }

## Overview

<What this skill is for, and when not to use it.>

## Workflow

### 1. <First step>

<Prefer shell commands (git, gh) over any one agent's built-in tools, so this stays
agent-agnostic.>
SKILL
    echo "Created $skill/SKILL.md"
  fi

  local agent
  for agent in "${agents[@]}"; do
    mkdir -p "$ROOT/$agent/skills"
    ln -sfn "../../skills/$name" "$ROOT/$agent/skills/$name"
    echo "Enabled for $agent"
  done

  relink_all
}

cmd_rename() {
  parse_root "$@"
  set -- "${REST[@]+"${REST[@]}"}"
  local old=${1:-} new=${2:-}
  [[ -n $old && -n $new ]] || usage 1

  # Without --root, use the one root that has <old>; refuse to guess between several.
  if [[ -z $ROOT_GIVEN ]]; then
    local found=() r
    for r in "${ROOTS[@]}"; do [[ -d $r/skills/$old ]] && found+=("${r%/}"); done
    if [[ ${#found[@]} -eq 1 ]]; then
      ROOT=${found[0]}
    elif [[ ${#found[@]} -gt 1 ]]; then
      printf 'Skill %s exists in several roots, pass --root:\n' "$old" >&2
      printf '  %s\n' "${found[@]}" >&2
      exit 1
    fi
  fi

  local src="$ROOT/skills/$old"
  local dst="$ROOT/skills/$new"
  [[ -d $src ]] || { echo "No such skill: $src" >&2; exit 1; }
  [[ ! -e $dst ]] || { echo "Skill already exists: $dst" >&2; exit 1; }

  mv "$src" "$dst"
  echo "Moved $src -> $dst"

  # Keep the frontmatter name in step with the directory name. -i.bak + rm because
  # in-place sed differs between macOS and GNU.
  if [[ -f $dst/SKILL.md ]]; then
    sed -i.bak "2,/^---\$/s/^name: $old\$/name: $new/" "$dst/SKILL.md" && rm -f "$dst/SKILL.md.bak"
  fi

  # Re-point every agent that had it enabled. Drop the old link in the agent's real
  # skills dir only if it was ours; a foreign skill of the same name is left alone,
  # since that is usually the conflict being worked around.
  local agent_dir agent link real
  for agent_dir in "$ROOT"/*/; do
    agent_dir=${agent_dir%/}
    agent=$(basename "$agent_dir")
    link="$agent_dir/skills/$old"
    [[ -L $link ]] || continue

    rm "$link"
    ln -sfn "../../skills/$new" "$agent_dir/skills/$new"

    real="$(skills_dir_for "$agent")/$old"
    if [[ -L $real && $(readlink "$real") == "$agent_dir/skills/$old" ]]; then
      rm "$real"
    fi
    echo "Renamed for $agent"
  done

  relink_all
}

cmd_roots() {
  printf '%s\n' "${ROOTS[@]}"
}

case "${1:-}" in
  link)
    shift
    if [[ $# -gt 0 ]]; then cmd_link "$@"; else relink_all; fi
    ;;
  add)
    shift
    cmd_add "$@"
    ;;
  rename)
    shift
    cmd_rename "$@"
    ;;
  roots) cmd_roots ;;
  -h | --help | help) usage ;;
  *) usage 1 ;;
esac
