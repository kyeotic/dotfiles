#!/usr/bin/env bash

# Manage agent-agnostic skills in .agents/.
#
#   agent-skill link                    link every enabled skill into its agent's config dir
#   agent-skill add <name> [agent...]   create the skill if missing, enable it, link it
#   agent-skill rename <old> <new>      rename a skill and relink it for every agent
#
# Skills live once in .agents/skills/<name>/. Each agent opts in via a symlink in
# .agents/<agent>/skills/. Default agents: claude codex.

set -eu

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
AGENTS_DIR="$DOTFILES/.agents"
DEFAULT_AGENTS=(claude codex)

usage() {
  sed -n '3,11p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# Where an agent reads its skills from.
skills_dir_for() {
  case $1 in
    claude) echo "$HOME/.claude/skills" ;;
    codex) echo "$HOME/.codex/skills" ;;
    *) echo "$HOME/.$1/skills" ;;
  esac
}

# Link .agents/<agent>/skills/* into the agent's real skills dir. Per-skill rather than
# the whole directory, because those dirs also hold skills installed by other tools.
link_agent() {
  local agent=$1
  local src="$AGENTS_DIR/$agent/skills"
  local tgt
  tgt=$(skills_dir_for "$agent")

  [[ -d $src ]] || return 0
  mkdir -p "$tgt"

  local skill dest
  for skill in "$src"/*; do
    [[ -e $skill ]] || continue
    dest="$tgt/$(basename "$skill")"
    if [[ -e $dest && ! -L $dest ]]; then
      echo "Skipping $agent skill, target is not a symlink: $dest"
      continue
    fi
    ln -sfn "$skill" "$dest"
  done
}

cmd_link() {
  local agent
  for agent in "$@"; do
    link_agent "$agent"
  done
}

cmd_add() {
  local name=${1:-}
  [[ -n $name ]] || usage 1
  shift

  local agents=("$@")
  [[ ${#agents[@]} -gt 0 ]] || agents=("${DEFAULT_AGENTS[@]}")

  local skill="$AGENTS_DIR/skills/$name"
  if [[ -d $skill ]]; then
    echo "Skill exists: $skill"
  else
    mkdir -p "$skill"
    cat > "$skill/SKILL.md" <<SKILL
---
name: $name
description: <one line: what this does, and the phrases that should trigger it>
---

# ${name//-/ }

## Overview

<What this skill is for, and when not to use it.>

## Workflow

### 1. <First step>

<Prefer shell commands (git, gh) over any one agent's built-in tools, so this stays
agent-agnostic.>
SKILL
    echo "Created $skill/SKILL.md"
  fi

  local agent
  for agent in "${agents[@]}"; do
    mkdir -p "$AGENTS_DIR/$agent/skills"
    ln -sfn "../../skills/$name" "$AGENTS_DIR/$agent/skills/$name"
    echo "Enabled for $agent"
  done

  cmd_link "${agents[@]}"
}

cmd_rename() {
  local old=${1:-} new=${2:-}
  [[ -n $old && -n $new ]] || usage 1

  local src="$AGENTS_DIR/skills/$old"
  local dst="$AGENTS_DIR/skills/$new"
  [[ -d $src ]] || { echo "No such skill: $src" >&2; exit 1; }
  [[ ! -e $dst ]] || { echo "Skill already exists: $dst" >&2; exit 1; }

  mv "$src" "$dst"
  echo "Moved $src -> $dst"

  # Keep the frontmatter name in step with the directory name. -i.bak + rm because
  # in-place sed differs between macOS and GNU.
  if [[ -f $dst/SKILL.md ]]; then
    sed -i.bak "2,/^---\$/s/^name: $old\$/name: $new/" "$dst/SKILL.md" && rm -f "$dst/SKILL.md.bak"
  fi

  # Re-point every agent that had it enabled. Drop the old link in the agent's real
  # skills dir only if it was ours; a foreign skill of the same name is left alone,
  # since that is usually the conflict being worked around.
  local agents=() agent_dir agent link real
  for agent_dir in "$AGENTS_DIR"/*/; do
    agent_dir=${agent_dir%/}
    agent=$(basename "$agent_dir")
    link="$agent_dir/skills/$old"
    [[ -L $link ]] || continue

    rm "$link"
    ln -sfn "../../skills/$new" "$agent_dir/skills/$new"
    agents+=("$agent")

    real="$(skills_dir_for "$agent")/$old"
    if [[ -L $real && $(readlink "$real") == "$agent_dir/skills/$old" ]]; then
      rm "$real"
    fi
    echo "Renamed for $agent"
  done

  if [[ ${#agents[@]} -gt 0 ]]; then
    cmd_link "${agents[@]}"
  fi
}

case "${1:-}" in
  link)
    shift
    if [[ $# -gt 0 ]]; then cmd_link "$@"; else cmd_link "${DEFAULT_AGENTS[@]}"; fi
    ;;
  add)
    shift
    cmd_add "$@"
    ;;
  rename)
    shift
    cmd_rename "$@"
    ;;
  -h | --help | help) usage ;;
  *) usage 1 ;;
esac
