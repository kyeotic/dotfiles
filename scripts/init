#!/usr/bin/env bash

set -eu

$HOME/dotfiles/scripts/install_shell
$HOME/dotfiles/scripts/install_apps

# install_apps puts tools in ~/.local/bin, which is only on PATH via .zshrc
export PATH="$HOME/.local/bin:$PATH"

# Sync vault secrets if config exists
if [[ -f "$HOME/dotfiles/.vault-sync.toml" ]]; then
  if command -v vault-sync >/dev/null 2>&1; then
    (cd "$HOME/dotfiles" && vault-sync sync)
  else
    echo "vault-sync not found; skipping secret sync"
  fi
fi

# Offer to clone active personal repos (not wanted on every machine, e.g. work)
if [[ -t 0 ]]; then
  printf "\nClone active personal repos into ~/dev? [y/N] "
  read -r CLONE_REPOS
  if [[ "$CLONE_REPOS" =~ ^[Yy] ]]; then
    $HOME/dotfiles/scripts/clone-active
  fi

  # NAS mounts need the home network and vault creds; Linux only
  if [[ "$(uname)" == "Linux" && -f "$HOME/.smb-share" ]]; then
    printf "\nMount KYE-NAS SMB shares at /mnt? [y/N] "
    read -r MOUNT_NAS
    if [[ "$MOUNT_NAS" =~ ^[Yy] ]]; then
      $HOME/dotfiles/scripts/setup-nas-mounts || echo "NAS mount setup failed; rerun setup-nas-mounts later"
    fi
  fi

  # Text expansion; needs sudo on Wayland, so it's opt-in. Linux only (macOS has its own)
  if [[ "$(uname)" == "Linux" ]] && ! grep -qi microsoft /proc/version 2>/dev/null; then
    printf "\nSet up espanso text expansion? [y/N] "
    read -r SETUP_ESPANSO
    if [[ "$SETUP_ESPANSO" =~ ^[Yy] ]]; then
      $HOME/dotfiles/scripts/setup-espanso || echo "espanso setup failed; rerun setup-espanso later"
    fi
  fi
fi

printf "\n\nInstall Complete\nStart a new terminal for all changes to take effect"
