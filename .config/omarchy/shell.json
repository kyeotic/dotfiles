{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "gamestats",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/gamestats",
          "interval": 1
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "kyeotic.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "birthYear": 0,
          "lifeExpectancy": 90
        },
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            }
          ]
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "kyeotic.sysmon",
          "display": "icon",
          "collapse": false
        }
      ],
      "tray": [
        {
          "id": "superwhisper.panel"
        }
      ]
    }
  },
  "plugins": []
}
