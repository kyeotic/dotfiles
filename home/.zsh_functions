#!/usr/bin/env bash

function colorize-log {
  colorize red ERROR | \
  colorize yellow 'WARN(ING)?' | \
  colorize green INFO | \
  colorize white DEBUG | \
  colorize white TRACE | \
  colorize red error | \
  colorize yellow 'warn(ing)?' | \
  colorize green info | \
  colorize white debug | \
  colorize white trace
}

function colorize {
  COLOR="$1"; shift
  ack --flush --passthru --color --color-match="$COLOR" $@
}

function aws-me {
  aws sts get-caller-identity | jq -r '.Account'
}

# Set up ~/.aws/config for Terraform use via IAM console login: a 'login' profile
# for `aws login`, plus a default profile backed by it. Non-destructive.
# Usage: aws-configure-tf [account-id] [iam-username] [region]
#   account-id:   AWS account ID (default: 902498034412)
#   iam-username: IAM username   (default: kyeotic)
#   region:       AWS region     (default: us-west-2)
# Example:
#   aws-configure-tf
#   aws-configure-tf 111122223333 tkye us-east-1
function aws-configure-tf {
  local account_id="${1:-902498034412}"
  local username="${2:-kyeotic}"
  local region="${3:-us-west-2}"

  # `aws configure set` edits keys in place, keeping any other profiles in the file
  aws configure set login_session "arn:aws:iam::${account_id}:user/${username}" --profile login || return
  aws configure set region "$region" --profile login || return
  _aws-ensure-default "$region" || return
  echo "AWS config updated in ${AWS_CONFIG_FILE:-~/.aws/config} (account: ${account_id}, user: ${username}, region: ${region})"
}

# Add a default profile that serves the 'login' profile's session through
# credential_process, so tools using the default credential chain (Terraform,
# SDKs, plain `aws`) work without --profile. Leaves an existing default alone,
# including an older `[profile default]` section.
# Usage: _aws-ensure-default [region]
function _aws-ensure-default {
  local cp="aws configure export-credentials --profile login --format process"
  if aws configure list-profiles 2>/dev/null | grep -qx default; then
    if [ "$(aws configure get credential_process --profile default 2>/dev/null)" != "$cp" ]; then
      echo "Note: default AWS profile exists and doesn't use the 'login' profile; left unchanged." >&2
    fi
    return 0
  fi
  local region="${1:-$(aws configure get region --profile login 2>/dev/null)}"
  aws configure set credential_process "$cp" --profile default || return
  aws configure set region "${region:-us-west-2}" --profile default || return
  echo "Added default AWS profile (credentials from the 'login' profile)."
}

# Log in to AWS via browser with the 'login' profile, then make sure a default
# profile points at it. Works on a fresh machine: `aws login` creates the
# 'login' profile (asking for a region), so aws-configure-tf is optional.
# Usage: aws-login [extra `aws login` args]
function aws-login {
  aws login --profile login "$@" || return
  _aws-ensure-default
}

function passgen {
  openssl rand -base64 $1
}

function g-prune-squashed {
  for branch in $(git for-each-ref --format='%(if:equals=[gone])%(upstream:track)%(then)%(refname:short)%(end)' refs/heads); do git branch -D $branch; done
}

function g-prune-sqaushed-dry {
  for branch in $(git for-each-ref --format='%(if:equals=[gone])%(upstream:track)%(then)%(refname:short)%(end)' refs/heads); do echo "$branch is ready to be deleted"; done
}

function gt-fresh {
  local branch="${1:-main}"
  gt get "$branch" --downstack --no-checkout --no-restack
}

function gt-new {
  if [[ -z "$1" ]]; then
    echo "Usage: gt-new <branch> [parent]"
    return 1
  fi

  local parent="${2:-main}"
  git switch -c "$1" "$parent" && gt track "$1" --parent "$parent"
}

function install-xinput {
