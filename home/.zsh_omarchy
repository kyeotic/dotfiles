# Omarchy-only shell functions. Sourced by .zshrc only when `omarchy` is on PATH.

# Install the latest amp-desktop-bin from the omarchy repo without syncing pacman's databases
# (no `-Sy`, so no partial upgrade): read the current filename from the live repo index, then
# `yay -U` that package file.
function update-amp {
  local repo file
  repo=$(pacman-conf --repo omarchy Server | head -n1)
  [[ -n $repo ]] || { echo "update-amp: no [omarchy] repo in pacman.conf" >&2; return 1; }
  file=$(curl -sfL "$repo/omarchy.db" | bsdtar -xOf - '*/desc' |
    awk '/^%FILENAME%/{getline; if ($0 ~ /^amp-desktop-bin-[0-9]/) print}')
  [[ -n $file ]] || { echo "update-amp: amp-desktop-bin not found in $repo/omarchy.db" >&2; return 1; }
  yay -U "$repo/$file"
}

# Keep a Bluetooth scan running for a while (default 120s) so a phone passkey sign-in
# (QR code) works in Chromium. On sites with passkey autofill, Chromium stops its own scan
# and starts a new one when the QR code opens; BlueZ rejects the restart with InProgress
# and Chromium never retries, so the phone sits on "connecting". With another scan holding
# discovery open, the restart succeeds. Run it, then open the QR code within the window.
function passkey-bt {
  local secs=${1:-120}
  [[ $secs == <-> ]] || { echo "usage: passkey-bt [seconds]" >&2; return 1; }
  bluetoothctl show | grep -q 'Powered: yes' ||
    { echo "passkey-bt: Bluetooth is off; turn it on first" >&2; return 1; }
  setsid -f bluetoothctl --timeout "$secs" scan on </dev/null >/dev/null 2>&1
  echo "Bluetooth scan running for ${secs}s; start the passkey sign-in now"
}
